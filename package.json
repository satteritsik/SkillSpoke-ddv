{
  "name": "@skillspoke/ddv",
  "version": "0.1.0",
  "description": "Dynamic Data View — TanStack Table data presentation library with automatic field discovery, multiple layouts, and pluggable adapters",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/build.mjs",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@tanstack/react-table": ">=8.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.5",
    "jsdom": "^27.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^4.0.5"
  },
  "keywords": [
    "tanstack-table",
    "data-table",
    "data-grid",
    "kanban",
    "board",
    "dynamic-data",
    "field-discovery",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/satteritsik/SkillSpoke-ddv.git"
  },
  "bugs": {
    "url": "https://github.com/satteritsik/SkillSpoke-ddv/issues"
  },
  "homepage": "https://github.com/satteritsik/SkillSpoke-ddv#readme"
}
